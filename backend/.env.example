APP_NAME=Artifactory
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
DATABASE_URL=sqlite:///./data/artifactory.db
ASSETS_DIR=./assets
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/gif","image/webp"]
ALLOWED_VIDEO_TYPES=["video/mp4","video/webm"]
ALLOWED_DOC_TYPES=["application/pdf"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
PASSWORD_MIN_LENGTH=12
LOG_LEVEL=INFO
REQUIRE_AUTH_FOR_READS=false
REQUIRE_AUTH_FOR_WRITES=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
STATS_CACHE_ENABLED=true
STATS_CACHE_TTL_SECONDS=15
SQL_SLOW_QUERY_LOG_ENABLED=true
SQL_SLOW_QUERY_THRESHOLD_MS=200
RATE_LIMIT_EXCLUDE_PATHS=["/health","/health/live","/health/ready","/metrics","/docs","/redoc","/openapi.json"]
