# Backend base URL used by Expo Go and standalone builds.
# Use your Mac LAN IP when testing on a physical iPhone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.50.223:8000/api/v1

# Backend readiness probe timeout used before mobile sync attempts.
EXPO_PUBLIC_BACKEND_READY_TIMEOUT_MS=3000

# Local display cache derivative for viewer fallback.
EXPO_PUBLIC_IMAGE_DISPLAY_MAX_EDGE=1600
EXPO_PUBLIC_IMAGE_DISPLAY_QUALITY=0.82

# Local thumbnail derivative for grids and final offline fallback.
EXPO_PUBLIC_IMAGE_THUMB_MAX_EDGE=300
EXPO_PUBLIC_IMAGE_THUMB_QUALITY=0.75

# Remote-derived display/thumb cache cap. Unsynced local originals are not evicted.
EXPO_PUBLIC_IMAGE_CACHE_LIMIT_MB=500

# 0 means process every queued job in one foreground run.
# Set to a small number, e.g. 1 or 3, when testing partial sync/resume behavior.
EXPO_PUBLIC_SYNC_MAX_JOBS_PER_RUN=0
