{
  "expo": {
    "name": "Artifactory",
    "slug": "artifactory-mobile",
    "scheme": "artifactory",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blkot.artifactory",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.blkot.artifactory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-share-extension",
        {
          "height": 220,
          "activationRules": [
            {
              "type": "text"
            },
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "file",
              "max": 1
            },
            {
              "type": "image",
              "max": 1
            },
            {
              "type": "video",
              "max": 1
            }
          ]
        }
      ],
      "./plugins/withNativeShareExtension",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Artifactory to choose photos from your library as kit assets.",
          "cameraPermission": "Allow Artifactory to take photos and save them as kit assets.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ArtifactoryShareExtension",
                  "bundleIdentifier": "com.blkot.artifactory.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.blkot.artifactory"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2ecd7451-e690-4732-a981-2a4e845dbb21"
      },
      "appleApplicationGroup": "group.com.blkot.artifactory"
    },
    "owner": "blkot"
  }
}
